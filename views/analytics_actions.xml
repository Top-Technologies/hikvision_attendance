<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
    
    <!-- ================================================================
         ANALYTICS ACTIONS (Phase 5)
    ================================================================ -->

    <!-- Wizard Actions -->
    <record id="action_analytics_wizard" model="ir.actions.act_window">
        <field name="name">Generate Analytics</field>
        <field name="res_model">hikvision.analytics.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_performance_wizard" model="ir.actions.act_window">
        <field name="name">Generate Performance Scores</field>
        <field name="res_model">hikvision.performance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_trend_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Trend Analysis</field>
        <field name="res_model">hikvision.trend.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Direct Model Actions -->
    <record id="action_attendance_analytics" model="ir.actions.act_window">
        <field name="name">Attendance Analytics</field>
        <field name="res_model">hikvision.attendance.analytics</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_monthly': 1}</field>
    </record>

    <record id="action_employee_performance" model="ir.actions.act_window">
        <field name="name">Employee Performance</field>
        <field name="res_model">hikvision.employee.performance</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_grade_aplus': 0, 'search_default_grade_a': 0}</field>
    </record>



    
    
</data>
</odoo>
