<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    
    
      <record id="view_analytics_wizard_form" model="ir.ui.view">
        <field name="name">hikvision.analytics.wizard.form</field>
        <field name="model">hikvision.analytics.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Analytics">
                <group>
                    <group>
                        <field name="period_type"/>
                        <field name="period_start"/>
                    </group>
                    <group>
                        <field name="department_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate Analytics" name="action_generate_analytics" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Performance Score Wizard -->
    <record id="view_performance_wizard_form" model="ir.ui.view">
        <field name="name">hikvision.performance.wizard.form</field>
        <field name="model">hikvision.performance.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Performance Scores">
                <group>
                    <field name="month"/>
                </group>
                <group>
                    <group>
                        <field name="department_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button string="Generate Scores" name="action_generate_performance" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Trend Analysis Wizard -->
    <record id="view_trend_analysis_wizard_form" model="ir.ui.view">
        <field name="name">hikvision.trend.analysis.wizard.form</field>
        <field name="model">hikvision.trend.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Trend Analysis">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="analysis_type"/>
                        <field name="department_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button string="Run Analysis" name="action_run_analysis" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    
    
</data>
</odoo>
