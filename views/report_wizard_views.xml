<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    
    

    <!-- ================================================================
         DAILY ATTENDANCE REGISTER WIZARD
    ================================================================ -->
    <record id="view_daily_register_wizard_form" model="ir.ui.view">
        <field name="name">hikvision.daily.register.wizard.form</field>
        <field name="model">hikvision.daily.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Daily Attendance Register">
                <group>
                    <group string="Report Parameters">
                        <field name="report_date"/>
                    </group>
                    <group string="Filters (leave empty for all)">
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_run" type="object" string="Generate Report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

